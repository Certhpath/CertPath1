<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Find an ISO 27001 consultant in the UK | Certpath</title>
<meta name="description" content="Need ISO 27001 to win a contract or pass a supplier check? Tell us what you need and we'll introduce you to up to three UK ISO 27001 consultants. Free for businesses.">
<link rel="canonical" href="https://certpath.co.uk/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F3F5F2; --surface:#FFFFFF; --ink:#1B2A2F; --muted:#56666B;
  --line:#C9D2CE; --teal:#0F6B5C; --teal-ink:#FFFFFF; --amber:#B97A0C; --tint:#E3EDE9;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#121A1C; --surface:#1A2427; --ink:#E6ECEA; --muted:#9DAAA7;
    --line:#2E3C3F; --teal:#4FB8A2; --teal-ink:#0C1A17; --amber:#E2A73C; --tint:#1F3330;
  }
}
:root[data-theme="dark"]{
  --paper:#121A1C; --surface:#1A2427; --ink:#E6ECEA; --muted:#9DAAA7;
  --line:#2E3C3F; --teal:#4FB8A2; --teal-ink:#0C1A17; --amber:#E2A73C; --tint:#1F3330;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--paper);color:var(--ink);font:400 1.0625rem/1.6 "Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2,h3{font-family:"Bricolage Grotesque","Instrument Sans",system-ui,sans-serif;line-height:1.1;margin:0}
a{color:var(--teal)}
:focus-visible{outline:3px solid var(--amber);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding:0 1.25rem}

header{border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0}
.logo{font:700 1.35rem/1 "Bricolage Grotesque",sans-serif;color:var(--ink);text-decoration:none;display:flex;align-items:center;gap:.5rem}
.logo svg{flex:none}
nav{display:flex;gap:1.25rem;align-items:center}
nav a{color:var(--ink);text-decoration:none;font-weight:500}
nav a:hover{color:var(--teal)}
@media (max-width:640px){nav .hide-sm{display:none}}

.hero{display:grid;grid-template-columns:1.05fr 1fr;gap:3rem;padding:3.5rem 0 4rem;align-items:start}
@media (max-width:880px){.hero{grid-template-columns:1fr;gap:2rem;padding-top:2rem}}
.hero h1{font-size:clamp(2.25rem,5.2vw,3.75rem);font-weight:700;letter-spacing:-.02em;max-width:14ch}
.hero p.lede{font-size:1.2rem;color:var(--muted);max-width:46ch;margin:1.25rem 0 1.5rem}
.facts{list-style:none;padding:0;margin:0;display:grid;gap:.6rem;max-width:46ch}
.facts li{display:flex;gap:.65rem;align-items:flex-start}
.facts svg{flex:none;margin-top:.3rem}

/* the clipboard: the one bold element */
.clip{background:var(--surface);border:2px solid var(--ink);border-radius:6px 6px 14px 14px;position:relative;padding:2.25rem 1.5rem 1.5rem;box-shadow:8px 8px 0 var(--teal)}
.clip::before{content:"";position:absolute;top:-14px;left:50%;transform:translateX(-50%);width:96px;height:26px;background:var(--ink);border-radius:6px}
.clip h2{font-size:1.5rem;margin-bottom:.25rem}
.clip .sub{color:var(--muted);margin:0 0 1.25rem;font-size:.95rem}
.progress{display:flex;gap:6px;margin-bottom:1.25rem}
.progress span{height:6px;flex:1;background:var(--line);border-radius:3px;transition:background .25s}
.progress span.on{background:var(--teal)}
fieldset{border:0;margin:0;padding:0}
legend{font-weight:600;font-size:1.1rem;margin-bottom:.75rem;padding:0}
.opt{display:flex;align-items:center;gap:.75rem;padding:.8rem .9rem;border:1px solid var(--line);border-radius:6px;margin-bottom:.5rem;cursor:pointer;background:var(--paper)}
.opt:hover{border-color:var(--teal)}
.opt input{width:1.15rem;height:1.15rem;accent-color:var(--teal);flex:none}
.opt:has(input:checked){border-color:var(--teal);background:var(--tint)}
label.field{display:block;font-weight:500;margin-bottom:.85rem}
label.field input,label.field textarea{display:block;width:100%;margin-top:.3rem;padding:.7rem .8rem;border:1px solid var(--line);border-radius:6px;background:var(--paper);color:var(--ink);font:inherit}
label.field input:focus,label.field textarea:focus{border-color:var(--teal)}
.step{display:none}
.step.active{display:block}
.actions{display:flex;justify-content:space-between;align-items:center;margin-top:1rem;gap:1rem}
button{font:600 1rem/1 "Instrument Sans",sans-serif;padding:.9rem 1.3rem;border-radius:6px;cursor:pointer;border:2px solid var(--teal)}
.btn-primary{background:var(--teal);color:var(--teal-ink)}
.btn-ghost{background:transparent;color:var(--teal);border-color:transparent;padding-left:0}
.btn-ghost[hidden]{display:none}
.err{color:var(--amber);font-weight:500;font-size:.95rem;min-height:1.4em;margin:.25rem 0 0}
.small{font-size:.875rem;color:var(--muted)}
.done{text-align:left}
.done h3{font-size:1.4rem;margin-bottom:.5rem}

section.band{padding:4rem 0;border-top:1px solid var(--line)}
section.band h2{font-size:clamp(1.75rem,3.5vw,2.5rem);letter-spacing:-.01em;margin-bottom:1.5rem;max-width:22ch}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;counter-reset:s;padding:0;list-style:none;margin:0}
@media (max-width:760px){.steps{grid-template-columns:1fr}}
.steps li{counter-increment:s;border-top:2px solid var(--ink);padding-top:1rem}
.steps li::before{content:counter(s);font:700 2.5rem/1 "Bricolage Grotesque",sans-serif;color:var(--teal);display:block;margin-bottom:.5rem}
.steps h3{font-size:1.2rem;margin-bottom:.4rem}
.steps p{margin:0;color:var(--muted)}

.two{display:grid;grid-template-columns:1fr 1fr;gap:3rem}
@media (max-width:820px){.two{grid-template-columns:1fr;gap:2rem}}
.drivers{margin:0;padding:0;list-style:none}
.drivers li{padding:.9rem 0;border-bottom:1px solid var(--line)}
.drivers strong{display:block}
.drivers span{color:var(--muted)}
.note{background:var(--tint);border-left:4px solid var(--teal);padding:1rem 1.2rem;border-radius:0 6px 6px 0}

.check{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:1.5rem}
.check label{display:flex;gap:.7rem;align-items:flex-start;padding:.5rem 0;cursor:pointer}
.check input{width:1.15rem;height:1.15rem;margin-top:.25rem;accent-color:var(--teal);flex:none}
.score{margin-top:1rem;padding-top:1rem;border-top:1px solid var(--line);font-weight:500}

details{border-bottom:1px solid var(--line);padding:1rem 0}
summary{cursor:pointer;font-weight:600;font-size:1.1rem}
details p{margin:.6rem 0 0;color:var(--muted);max-width:68ch}

footer{border-top:1px solid var(--line);padding:2.5rem 0;color:var(--muted);font-size:.95rem}
footer .row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem}
</style>
</head>
<body>
<header>
  <div class="wrap bar">
    <a class="logo" href="#top" aria-label="Certpath home">
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><rect x="2" y="2" width="22" height="22" rx="5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M7.5 13.5l3.5 3.5 7.5-8" fill="none" stroke="var(--teal)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Certpath
    </a>
    <nav aria-label="Main">
      <a class="hide-sm" href="#how">How it works</a>
      <a class="hide-sm" href="#cost">Costs</a>
      <a href="#partners">For consultants</a>
    </nav>
  </div>
</header>

<main id="top">
  <div class="wrap hero">
    <div>
      <h1>Need ISO 27001 to win a contract?</h1>
      <p class="lede">Tell us what's driving it, your size and your deadline. We'll introduce you to up to three UK consultants who handle projects like yours.</p>
      <ul class="facts">
        <li><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9.5l4 4 8-9" fill="none" stroke="var(--teal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Free for your business. Consultants pay us a fee for introductions.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9.5l4 4 8-9" fill="none" stroke="var(--teal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>No obligation. Compare approaches and quotes, then decide.</span></li>
        <li><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9.5l4 4 8-9" fill="none" stroke="var(--teal)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Takes about a minute.</span></li>
      </ul>
    </div>

    <div class="clip" id="match">
      <h2>Get matched</h2>
      <p class="sub">Four quick questions.</p>
      <div class="progress" aria-hidden="true"><span class="on"></span><span></span><span></span><span></span></div>

      <!-- On Netlify, data-netlify handles submissions. Elsewhere, set action to your form endpoint (e.g. Formspree). -->
      <form id="lead" name="iso27001-enquiry" method="POST" data-netlify="true" netlify-honeypot="company_url" novalidate>
        <input type="hidden" name="form-name" value="iso27001-enquiry">
        <p hidden><label>Leave blank <input name="company_url"></label></p>

        <div class="step active" data-step="1">
          <fieldset>
            <legend>What's driving the need for ISO 27001?</legend>
            <label class="opt"><input type="radio" name="driver" value="Customer or tender requires it" required>A customer or tender requires it</label>
            <label class="opt"><input type="radio" name="driver" value="Winning larger clients">We want to win larger clients</label>
            <label class="opt"><input type="radio" name="driver" value="Investor or board request">Investor or board request</label>
            <label class="opt"><input type="radio" name="driver" value="Exploring">Just exploring</label>
          </fieldset>
        </div>

        <div class="step" data-step="2">
          <fieldset>
            <legend>How many people work in your business?</legend>
            <label class="opt"><input type="radio" name="size" value="1-10" required>1 to 10</label>
            <label class="opt"><input type="radio" name="size" value="11-50">11 to 50</label>
            <label class="opt"><input type="radio" name="size" value="51-250">51 to 250</label>
            <label class="opt"><input type="radio" name="size" value="250+">More than 250</label>
          </fieldset>
        </div>

        <div class="step" data-step="3">
          <fieldset>
            <legend>When do you need to be certified?</legend>
            <label class="opt"><input type="radio" name="timeline" value="Within 3 months" required>Within 3 months</label>
            <label class="opt"><input type="radio" name="timeline" value="3-6 months">3 to 6 months</label>
            <label class="opt"><input type="radio" name="timeline" value="6-12 months">6 to 12 months</label>
            <label class="opt"><input type="radio" name="timeline" value="No deadline">No fixed deadline</label>
          </fieldset>
        </div>

        <div class="step" data-step="4">
          <label class="field">Your name<input name="name" autocomplete="name" required></label>
          <label class="field">Work email<input type="email" name="email" autocomplete="email" required></label>
          <label class="field">Company<input name="company" autocomplete="organization" required></label>
          <label class="field">Phone (optional)<input type="tel" name="phone" autocomplete="tel"></label>
          <label class="field">Anything else? (optional)<textarea name="notes" rows="2"></textarea></label>
          <p class="small">We'll share your details with the consultants we introduce you to. We never sell them. <a href="#privacy-notice">Privacy notice</a></p>
        </div>

        <p class="err" id="err" role="alert"></p>
        <div class="actions">
          <button type="button" class="btn-ghost" id="back" hidden>Back</button>
          <button type="button" class="btn-primary" id="next">Next</button>
        </div>
      </form>

      <div class="done" id="done" hidden tabindex="-1">
        <h3>Request sent</h3>
        <p>Thanks. We'll email you within one working day with the consultants we think fit best.</p>
      </div>
    </div>
  </div>

  <section class="band" id="how">
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="steps">
        <li><h3>Tell us what you need</h3><p>Your reason, size and deadline shape which consultants make sense.</p></li>
        <li><h3>We introduce up to three</h3><p>Consultants with experience at your size and timeline get in touch directly.</p></li>
        <li><h3>You choose</h3><p>Compare their approach and price. There's no obligation and no cost to you.</p></li>
      </ol>
    </div>
  </section>

  <section class="band" id="cost">
    <div class="wrap two">
      <div>
        <h2>What affects the cost of ISO 27001?</h2>
        <ul class="drivers">
          <li><strong>Scope</strong><span>How many people, sites and systems are included.</span></li>
          <li><strong>Where you're starting from</strong><span>Existing policies, controls or Cyber Essentials reduce the work.</span></li>
          <li><strong>How much help you want</strong><span>Full implementation costs more than gap analysis and audit preparation.</span></li>
          <li><strong>Your deadline</strong><span>Tight timelines need more consultant time up front.</span></li>
        </ul>
        <p class="note">Consultancy is one cost. The certification audit itself is carried out separately by an accredited certification body, so budget for both.</p>
      </div>
      <div>
        <h2>How ready are you?</h2>
        <div class="check" id="ready">
          <label><input type="checkbox">We keep a list of our information assets and who owns them</label>
          <label><input type="checkbox">We've done a documented information security risk assessment</label>
          <label><input type="checkbox">We have written access control and password policies</label>
          <label><input type="checkbox">We check the security of key suppliers</label>
          <label><input type="checkbox">We have a plan for handling security incidents</label>
          <label><input type="checkbox">Staff get regular security awareness training</label>
          <p class="score" id="score" aria-live="polite">Tick what's already in place.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="faq">
    <div class="wrap">
      <h2>Common questions</h2>
      <details><summary>How long does ISO 27001 certification take?</summary><p>It depends on your size, scope and starting point. Many smaller businesses take several months from starting work to passing the certification audit. A consultant can give you a realistic plan once they understand your setup.</p></details>
      <details><summary>What's the difference between ISO 27001 and Cyber Essentials?</summary><p>Cyber Essentials is a UK government-backed scheme covering a set of basic technical controls. ISO 27001 is an international standard for running an information security management system across your whole business. Some customers ask for one, some for both.</p></details>
      <details><summary>Is this really free?</summary><p>Yes, for businesses looking for a consultant. Consultants pay us a fee when we introduce them to you. That never changes what you pay them.</p></details>
      <details><summary>Do I have to go with one of the consultants?</summary><p>No. You can talk to them, compare quotes and decide not to go ahead.</p></details>
    </div>
  </section>

  <section class="band" id="partners">
    <div class="wrap">
      <h2>Are you an ISO 27001 consultant?</h2>
      <p style="max-width:60ch">We introduce UK businesses that have a real reason to certify, with their size and deadline already confirmed. Get in touch to join the network.</p>
      <p><a href="mailto:consultant@certpath.co.uk">consultant@certpath.co.uk</a></p>
    </div>
  </section>

  <section class="band" id="privacy-notice">
    <div class="wrap" style="max-width:72ch">
      <h2>Privacy notice</h2>
      <p class="small">Last updated: October 2026</p>
      <h3 style="font-size:1.15rem;margin:1.5rem 0 .4rem">Who we are</h3>
      <p>Certpath is run by Wes Lewis, a sole trader based in England, who is the data controller for the information you give us. Contact: <a href="mailto:consultant@certpath.co.uk">consultant@certpath.co.uk</a>.</p>
      <h3 style="font-size:1.15rem;margin:1.5rem 0 .4rem">What we collect</h3>
      <p>When you use the form, we collect your name, work email, company name, phone number if you give it, your answers about why you need ISO 27001, your company size and timeline, and any notes you add.</p>
      <h3 style="font-size:1.15rem;margin:1.5rem 0 .4rem">Why we use it</h3>
      <p>We use your details to respond to your request and introduce you to up to three ISO 27001 consultants. Our lawful basis is legitimate interests: you've asked us to make these introductions, and we only use your details for that purpose. We won't add you to a mailing list without asking.</p>
      <h3 style="font-size:1.15rem;margin:1.5rem 0 .4rem">Who we share it with</h3>
      <p>We share your details with the consultants we introduce you to, who will contact you directly. Once they have your details, they're responsible for how they use them. We also use service providers to run this site and our email: Netlify (website hosting and form handling) and Google Workspace (email). These providers may process data outside the UK under appropriate safeguards. This site loads fonts from Google, which means Google receives your IP address. We never sell your details.</p>
      <h3 style="font-size:1.15rem;margin:1.5rem 0 .4rem">How long we keep it</h3>
      <p>We keep your enquiry for 12 months, then delete it.</p>
      <h3 style="font-size:1.15rem;margin:1.5rem 0 .4rem">Your rights</h3>
      <p>You can ask to see the information we hold about you, correct it, delete it, restrict or object to how we use it, or get a copy to move elsewhere. Email <a href="mailto:consultant@certpath.co.uk">consultant@certpath.co.uk</a> and we'll respond within one month. If you're unhappy with how we've handled your information, you can complain to the Information Commissioner's Office at <a href="https://ico.org.uk/make-a-complaint/">ico.org.uk</a>.</p>
      <h3 style="font-size:1.15rem;margin:1.5rem 0 .4rem">Cookies</h3>
      <p>This site doesn't set its own cookies or use tracking.</p>
    </div>
  </section>
</main>

<footer>
  <div class="wrap row">
    <span>© Certpath. An introduction service. We are not a certification body.</span>
    <a href="#privacy-notice">Privacy notice</a>
  </div>
</footer>

<script>
(function(){
  const form=document.getElementById('lead');
  const steps=[...form.querySelectorAll('.step')];
  const bars=[...document.querySelectorAll('.progress span')];
  const next=document.getElementById('next'), back=document.getElementById('back');
  const err=document.getElementById('err');
  let i=0;

  function show(n){
    steps.forEach((s,k)=>s.classList.toggle('active',k===n));
    bars.forEach((b,k)=>b.classList.toggle('on',k<=n));
    back.hidden=n===0;
    next.textContent=n===steps.length-1?'Send request':'Next';
    err.textContent='';
    const first=steps[n].querySelector('input');
    if(first && n>0) first.focus();
  }

  function valid(n){
    const s=steps[n];
    const radios=s.querySelectorAll('input[type=radio]');
    if(radios.length && ![...radios].some(r=>r.checked)){err.textContent='Choose one option to continue.';return false;}
    for(const f of s.querySelectorAll('input[required]:not([type=radio])')){
      if(!f.value.trim()){err.textContent='Add your '+f.closest('label').childNodes[0].textContent.trim().toLowerCase()+' to continue.';f.focus();return false;}
      if(f.type==='email' && !/^\S+@\S+\.\S+$/.test(f.value)){err.textContent='Enter a valid email address, like name@company.co.uk.';f.focus();return false;}
    }
    return true;
  }

  next.addEventListener('click',async()=>{
    if(!valid(i)) return;
    if(i<steps.length-1){i++;show(i);return;}
    next.disabled=true; next.textContent='Sending…';
    try{
      const body=new URLSearchParams(new FormData(form)).toString();
      const res=await fetch(form.getAttribute('action')||'/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});
      if(!res.ok) throw new Error();
      form.hidden=true;
      document.querySelector('.progress').hidden=true;
      const d=document.getElementById('done'); d.hidden=false; d.focus();
    }catch(e){
      err.textContent="Your request didn't send. Check your connection and try again.";
      next.disabled=false; next.textContent='Send request';
    }
  });
  back.addEventListener('click',()=>{if(i>0){i--;show(i);}});

  const boxes=[...document.querySelectorAll('#ready input')], score=document.getElementById('score');
  boxes.forEach(b=>b.addEventListener('change',()=>{
    const n=boxes.filter(x=>x.checked).length;
    score.textContent = n===0 ? "Tick what's already in place." :
      n<=2 ? n+' of 6 in place. Expect a full implementation project.' :
      n<=4 ? n+' of 6 in place. You have a foundation to build on.' :
      n+' of 6 in place. A gap analysis may be all you need before the audit.';
  }));
})();
</script>
</body>
</html>
